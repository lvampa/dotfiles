{
  "theme": "dark",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/chezmoi/**)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push*--delete*)",
      "Bash(git push*:*)",
      "Bash(git push*main*)",
      "Bash(git push*master*)",
      "Bash(git push*HEAD*)",
      "Bash(gh pr merge*)",
      "Bash(gh * -R *)",
      "Bash(gh * --repo *)",
      "Bash(gh *--repo=*)",
      "Bash(GH_REPO=*)",
      "Bash(gh api*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo create*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh gist*)",
      "Bash(gh auth logout*)"
    ],
    "allow": [
      "Bash(git push origin *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)",
      "Bash(chezmoi status*)",
      "Bash(chezmoi diff*)",
      "Bash(chezmoi managed*)",
      "Bash(chezmoi source-path*)",
      "Bash(chezmoi data*)",
      "Bash(chezmoi execute-template*)",
      "Bash(chezmoi apply*)",
      "Bash(chezmoi re-add*)",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm -rf *)"
    ],
    "additionalDirectories": [
      "~/.claude",
      "~/.agents",
      "/private/tmp/claude-{{ .chezmoi.uid }}"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "excludedCommands": ["gh", "chezmoi"],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "rubygems.org",
        "proxy.golang.org",
        "formulae.brew.sh",
        "ghcr.io"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config/chezmoi"]
    }
  },
  "plansDirectory": ".claude/plans",
  "worktree": {
    "baseRef": "fresh"
  },
  {{ if env "FIGMA_ACCESS_TOKEN" -}}
  "env": {
    "FIGMA_ACCESS_TOKEN": "{{ env "FIGMA_ACCESS_TOKEN" }}"
  },
  {{ end -}}
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-writes-outside-project.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && printf '\\a' > $(tmux display-message -p '#{pane_tty}')"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && printf '\\a' > $(tmux display-message -p '#{pane_tty}')"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  }
}
